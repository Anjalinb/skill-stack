#ACCOUNTS ENDPOINTS

#API call for creating a user
###
POST http://127.0.0.1:8000/accounts/user/signup/
Content-Type: application/json

{
    "username":"safa",
    "password":"safa123",
    "email":"safa@gmail.com",
    "phone":"603587654"

}

#API call for creating an admin  user
###
POST http://127.0.0.1:8000/accounts/admin/signup/
Content-Type: application/json

{
    "username":"rohan",
    "password":"rohan123",
    "email":"rohan@gmail.com",
    "phone":"953587655",
    "role":"trainer"

}

#API call for creating a token
###
POST http://127.0.0.1:8000/accounts/token/
Content-Type: application/json

{
    "username":"admin",
    "password":"admin123"
}

#API call for updating trainer profile
###
PUT http://127.0.0.1:8000/accounts/trainerprofile/update/
Content-Type: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

{
    "expertise_areas": "Web development, REST APIs, database design",
    "qualification": "B.Tech in Computer Science",
    "languages": "Python, JavaScript, SQL",
    "experience_years": "3",
    "githuburl": "https://github.com/example-user",
    "linkedurl": "https://www.linkedin.com/in/example-user"
  }

#API call for getting the profile of trainer
###
GET http://127.0.0.1:8000/accounts/trainerprofile/detail/
Accept: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

#====================COURSE ENDPOINTS===================
#API call for listing all courses of the logged in trainer
###
GET http://127.0.0.1:8000/programs/courses/
Accept: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

#API call for creating a course
###
POST http://127.0.0.1:8000/programs/courses/
Content-Type: application/json
Authorization: Token 4332b90a527337218bcaeff7ca162ebed4a8ad79

  {
    "title": "Java Application Development",
    "description": "Build Java applications using object-oriented principles, collections, and file handling.",
    "fee": 8000,
    "duration": "10 weeks",
    "language": "java"
  }

#API call for retrieving a course
###
GET http://127.0.0.1:8000/programs/courses/1/
Accept: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

#API call for updating a course
###
PUT http://127.0.0.1:8000/programs/courses/1/
Content-Type: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

{
    "title": "Python Fundamentals",
    "description": "Learn Python syntax, variables, control flow, functions, and basic data structures.",
    "fee": 5000,
    "duration": "7 weeks",
    "language": "python"
  }

#API call for deleting a course
###
DELETE http://127.0.0.1:8000/programs/courses/3/
Accept: application/json
Authorization: Token ac9e2debb69f5962dd60104e8b00808cde6564f7

